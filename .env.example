# Copy to .env and fill in. Never commit .env.

# Default provider: claude | openai | ollama | mock  (can also be switched per request in the UI)
LLM_PROVIDER=claude
# Leave empty for the provider default (claude-sonnet-5-5, gpt-4.1, qwen2.5-coder:7b)
LLM_MODEL=
LLM_TEMPERATURE=0.2

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama on your host; docker-compose rewrites this for the container
OLLAMA_BASE_URL=http://localhost:11434

# Local (non-docker) runs only; docker-compose sets these itself
# DATABASE_URL=postgresql+psycopg://cloudsketch:cloudsketch@localhost:5432/cloudsketch
# PARSER_URL=http://localhost:7070
